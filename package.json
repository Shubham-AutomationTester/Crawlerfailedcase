{
  "name": "studio-5619-crawl-lab",
  "version": "1.2.0",
  "private": true,
  "description": "15,000-URL crawl lab plus 80 error-details input and product-check scenarios",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-site.mjs",
    "export:expected": "node scripts/export-expected.mjs",
    "check:issues": "node scripts/check-issues.mjs",
    "compare:providers": "node scripts/compare-providers.mjs",
    "check:error-details": "node scripts/check-error-details.mjs",
    "export:error-details": "node scripts/export-error-details.mjs"
  }
}
